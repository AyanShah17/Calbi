# Copy to .env and fill in. NEVER commit .env or real keys.

# LLM providers (use one or both)
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Pick the provider/model used by llm_from_env() and live tests
CALBI_LLM_PROVIDER=openrouter
CALBI_LLM_MODEL=

# Optional OpenRouter attribution headers
# CALBI_APP_URL=
# CALBI_APP_NAME=Calbi

# Neon Postgres (pooled host, sslmode=require)
DATABASE_URL=
# Direct (non-pooled) host, optional, used for migrations
# DATABASE_URL_DIRECT=
